// =====================================================================
// Pipeline declarativo do job Selenium WebDriver + Jenkins.
// Executa dentro do próprio contêiner ac-jenkins (Maven + Chrome
// já vêm instalados pelo Dockerfile compartilhado em ../../docker).
// =====================================================================
pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        // Caminho do projeto Maven RELATIVO ao workspace do Jenkins
        // (o repositório é clonado pelo "Checkout SCM" para a workspace).
        PROJECT_DIR = 'job/Selenium_WebDriver_Jenkins'
    }

    stages {
        stage('Ferramentas') {
            steps {
                echo "Projeto: ${PROJECT_DIR}"
                sh 'java -version && mvn -version && google-chrome --version'
            }
        }

        stage('Build') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh 'mvn -B -ntp clean compile test-compile'
                }
            }
        }

        stage('Testes Selenium') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh 'mvn -B -ntp test'
                }
            }
        }
    }

    post {
        always {
            // Publica o relatório JUnit (gerado pelo checkout do SCM nesta workspace)
            junit testResults: "${PROJECT_DIR}/target/surefire-reports/*.xml",
                  allowEmptyResults: true

            // Plugin obrigatório da AC: Chuck Norris (step de pipeline).
            // O EZ Wall NÃO tem step de pipeline: ele é um plugin de "view"
            // que adiciona automaticamente o link de wall display a cada
            // build assim que instalado, então já está "em uso" no job.
            chuckNorris()
        }
        success { echo 'Pipeline Selenium finalizado com SUCESSO.' }
        failure { echo 'Pipeline Selenium FALHOU - verifique o relatório JUnit.' }
    }
}
